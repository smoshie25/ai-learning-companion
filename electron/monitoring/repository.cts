import { createHash,randomUUID } from 'node:crypto'
import type { DatabaseSync } from 'node:sqlite'
import { transaction } from '../persistence/database.cjs'
import { AppError } from '../ai/errors.cjs'
import { opportunitySchema,type Opportunity,type MonitoringSnapshot } from '../../shared/monitoring-contracts.cjs'
export const opportunityDigest=(o:Opportunity)=>createHash('sha256').update(JSON.stringify({url:o.url,title:o.title,cost:o.cost,eligibility:o.eligibility,deadline:o.deadline,free:o.free,verification:o.verification})).digest('hex')
export class MonitoringRepository {
 constructor(private db:DatabaseSync){}
 save(o:Opportunity){const value=opportunitySchema.parse(o);this.db.prepare('INSERT INTO verified_opportunities VALUES (?,?) ON CONFLICT(url) DO UPDATE SET data=excluded.data').run(value.url,JSON.stringify(value));return value}
 results(query=''){return this.db.prepare('SELECT data FROM verified_opportunities').all().map(r=>opportunitySchema.parse(JSON.parse(r.data as string))).filter(o=>[o.title,o.provider].join(' ').toLowerCase().includes(query.toLowerCase())).sort((a,b)=>b.relevance-a.relevance).slice(0,100)}
 enabled(id:string){return this.db.prepare('SELECT enabled FROM opportunity_watches WHERE id=?').get(id)?.enabled===1}
 renew(id:string,token:string,now:number){return !!this.db.prepare('UPDATE monitoring_leases SET expires_at=? WHERE watch_id=? AND token=?').run(now+600000,id,token).changes}
 disable(id:string){if(!this.db.prepare('UPDATE opportunity_watches SET enabled=0 WHERE id=?').run(id).changes)throw new AppError('NOT_FOUND','This watch is unavailable.')}
 claim(id:string,now:number){return transaction(this.db,()=>{if(!this.enabled(id))return null;const row=this.db.prepare('SELECT expires_at,next_at FROM monitoring_leases WHERE watch_id=?').get(id);if(row&&(Number(row.expires_at)>now||Number(row.next_at)>now))return null;const token=randomUUID();this.db.prepare('INSERT INTO monitoring_leases VALUES (?,?,?,0,NULL) ON CONFLICT(watch_id) DO UPDATE SET token=excluded.token,expires_at=excluded.expires_at').run(id,token,now+600000);return token})}
 finish(id:string,token:string,now:number,interval:number,state:string,message:string){transaction(this.db,()=>{const changed=this.db.prepare('UPDATE monitoring_leases SET expires_at=0,next_at=?,last_run=? WHERE watch_id=? AND token=?').run(now+interval*3600000,new Date(now).toISOString(),id,token);if(changed.changes)this.record(id,state,message,now)})}
 record(id:string,state:string,message:string,now=Date.now()){this.db.prepare('INSERT INTO monitoring_runs VALUES (?,?,?,?,?)').run(randomUUID(),id,new Date(now).toISOString(),state,message.slice(0,600))}
 observe(watchId:string,o:Opportunity){return transaction(this.db,()=>{const digest=opportunityDigest(o);const old=this.db.prepare('SELECT digest FROM monitoring_seen WHERE watch_id=? AND url=?').get(watchId,o.url);this.db.prepare('INSERT INTO monitoring_seen VALUES (?,?,?) ON CONFLICT(watch_id,url) DO UPDATE SET digest=excluded.digest').run(watchId,o.url,digest);if(old?.digest===digest)return false;const id=createHash('sha256').update(watchId+'\0'+o.url+'\0'+digest).digest('hex');this.db.prepare('INSERT OR IGNORE INTO monitoring_alerts VALUES (?,?,NULL,?,?)').run(id,watchId,'detected',JSON.stringify(o));return true})}
 alerts(watchId:string){return this.db.prepare('SELECT * FROM monitoring_alerts WHERE watch_id=?').all(watchId).map(r=>({id:r.id as string,watchId:r.watch_id as string,actionId:r.action_id as string|null,state:r.state as string,opportunity:opportunitySchema.parse(JSON.parse(r.data as string))}))}
 attach(id:string,actionId:string){this.db.prepare("UPDATE monitoring_alerts SET action_id=?,state='needs-review' WHERE id=?").run(actionId,id)}
 state(id:string,state:string){this.db.prepare('UPDATE monitoring_alerts SET state=? WHERE id=?').run(state,id)}
 snapshot():MonitoringSnapshot{const watches=this.db.prepare('SELECT w.*,l.last_run FROM opportunity_watches w LEFT JOIN monitoring_leases l ON l.watch_id=w.id').all().map(r=>({id:r.id as string,enabled:!!r.enabled,...JSON.parse(r.data as string),lastRun:r.last_run as string|null}));return {watches,runs:this.db.prepare('SELECT watch_id,at,state,message FROM monitoring_runs ORDER BY at DESC LIMIT 30').all().map(r=>({watchId:r.watch_id as string,at:r.at as string,state:r.state as string,message:r.message as string})),alerts:watches.flatMap(w=>this.alerts(w.id)).slice(-50),note:'No background worker is installed. Checks run only when the CLI worker or a configured scheduler runs. Every notification email requires exact Action Center approval.'}}
}

import { randomUUID } from 'node:crypto'
import type { z } from 'zod'
import type { AIService } from '../ai/service.cjs'
import type { InterviewService } from '../ai/interview-service.cjs'
import type { LearningRepository } from '../persistence/learning-repository.cjs'
import { DocumentRepository } from './repository.cjs'
import { importStudyFile } from './importer.cjs'
import { validateAnalysis,validateAnswer,validateSynthesis,validateEvidence,evidenceFrom,retrieveChunks } from './grounding.cjs'
import { documentPlanSchema,documentQuestionsSchema,documentStudySchema,documentInterviewSchema,documentAnalyzeSchema,documentAskSchema,documentSelectionSchema,type StudyDocument,type DocumentChunk,type GroundedPoint } from '../../shared/document-contracts.cjs'
import { validateProposal } from '../ai/study-planning.cjs'
import { AppError } from '../ai/errors.cjs'
export class DocumentService {
 private active=new Set<string>();private canceled=new Set<string>();private disposed=false;private importing=false
 constructor(readonly repository:DocumentRepository,private ai:AIService,private plans:LearningRepository,private interviews:InterviewService,private importer=importStudyFile){repository.recover()}
 hasAIWork(){return this.active.size>0}
 async importFile(filename:string){if(this.importing)throw new AppError('BUSY','Wait for the current local extraction.');this.importing=true;try{const result=await this.importer(filename);if(this.disposed)throw new AppError('CLOSED','The document library closed.');return this.repository.create({id:randomUUID(),title:result.title,format:result.format,hash:result.hash,createdAt:new Date().toISOString(),characters:result.chunks.reduce((n,c)=>n+c.text.length,0),pages:result.extracted.pages,warning:result.extracted.warning,state:'ready',message:'Extracted locally. No content has been sent to OpenAI.',executive:[],chapters:[],consentAt:null},result.chunks)}finally{this.importing=false}}
 private consent(id:string,consent:boolean){if(!consent)throw new AppError('CONSENT_REQUIRED','Approve transmitting document content to OpenAI for this operation.');if(this.disposed)throw new AppError('CLOSED','The document library closed.');const doc=this.repository.get(id);this.repository.save({...doc,consentAt:new Date().toISOString()});return doc}
 private async exclusive<T>(id:string,consent:boolean,work:()=>Promise<T>){this.consent(id,consent);if(this.active.size)throw new AppError('BUSY','Wait for or pause the current document AI operation.');this.active.add(id);try{return await work()}finally{this.active.delete(id)}}
 private stopped(id:string){return this.disposed||this.canceled.has(id)}
 analyze(input:z.infer<typeof documentAnalyzeSchema>){this.consent(input.id,input.consent);if(this.active.size)throw new AppError('BUSY','Pause or finish the current document AI operation.');if(this.repository.get(input.id).state==='complete')return this.repository.get(input.id);const chunks=this.repository.chunks(input.id);if(input.chunkIds?.some(id=>!chunks.some(c=>c.id===id)))throw new AppError('NOT_FOUND','A selected section is unavailable.');this.active.add(input.id);this.canceled.delete(input.id);const doc=this.repository.get(input.id);this.repository.save({...doc,state:'analyzing',message:'Analyzing source sections…'});void this.runAnalysis(input).finally(()=>{this.active.delete(input.id);this.canceled.delete(input.id)});return this.repository.get(input.id)}
 cancelAll(){for(const id of this.active)this.canceled.add(id)}
 cancel(id:string){this.repository.get(id);if(this.active.has(id))this.canceled.add(id)}
 private async runAnalysis(input:z.infer<typeof documentAnalyzeSchema>){const id=input.id;try{
  const selected=this.repository.chunks(id).filter(c=>(!input.chunkIds||input.chunkIds.includes(c.id))&&c.state!=='complete'&&(!input.retryFailed||c.state==='failed'))
  let errors=0;for(const c of selected){if(this.stopped(id))break;this.repository.saveChunk(id,{...this.repository.chunk(id,c.id),state:'working',error:null});try{const analysis=validateAnalysis(await this.ai.documentSection(c),[c]);if(this.disposed)return;this.repository.saveChunk(id,{...this.repository.chunk(id,c.id),state:'complete',analysis,error:null});errors=0}catch(error){if(this.disposed)return;this.repository.saveChunk(id,{...this.repository.chunk(id,c.id),state:'failed',error:error instanceof AppError?error.message:'This section did not produce valid source-grounded output. Retry it.'});errors++;if(errors>=3||error instanceof AppError&&['NOT_CONFIGURED','OFFLINE_MODE','AUTHENTICATION','RATE_LIMIT','NETWORK','TIMEOUT'].includes(error.code))break}}
  if(this.disposed)return
  if(this.canceled.has(id)){this.repository.save({...this.repository.get(id),state:'paused',message:'Paused after the current request. Completed sections are retained.'});return}
  const chunks=this.repository.chunks(id);if(chunks.some(c=>c.state!=='complete')){this.repository.save({...this.repository.get(id),state:chunks.some(c=>c.state==='failed')?'failed':'paused',message:'Completed sections are retained. Retry failed sections or continue the remaining analysis.'});return}
  const groups=new Map<string,DocumentChunk[]>();for(const c of chunks)groups.set(c.heading,[...(groups.get(c.heading)??[]),c]);const chapters=[...this.repository.get(id).chapters]
  for(const [heading,group] of groups){if(this.stopped(id))break;if(chapters.some(c=>c.heading===heading))continue;this.repository.save({...this.repository.get(id),message:`Summarizing chapter ${chapters.length+1} of ${groups.size}…`});const points=group.flatMap(c=>[...c.analysis!.summary.slice(0,2),...c.analysis!.concepts.slice(0,1),...c.analysis!.priorities.slice(0,1)]);chapters.push({heading,points:await this.reduce(points,chunks,id)});if(!this.stopped(id))this.repository.save({...this.repository.get(id),chapters})}
  if(this.stopped(id)){if(!this.disposed)this.repository.save({...this.repository.get(id),state:'paused',message:'Hierarchical summary paused. Section analysis is retained.'});return}
  this.repository.save({...this.repository.get(id),message:'Building the executive summary from cited chapter summaries…'});const executive=await this.reduce(chapters.flatMap(c=>c.points),chunks,id,true);if(this.stopped(id)){if(!this.disposed)this.repository.save({...this.repository.get(id),state:'paused',message:'Analysis paused. Resume to finish the executive summary.'});return}
  this.repository.save({...this.repository.get(id),state:'complete',executive,chapters,message:'Source-grounded analysis saved. Review cited excerpts; AI interpretation may still need correction.'})
 }catch(error){if(!this.disposed)this.repository.save({...this.repository.get(id),state:'failed',message:error instanceof AppError?error.message:'Hierarchical analysis failed. Completed source sections remain available; retry to finish.'})}}
 private async reduce(points:GroundedPoint[],chunks:DocumentChunk[],id:string,force=false):Promise<GroundedPoint[]>{if(points.length<=4&&!force)return points;let current=points;while(current.length>8){const next:GroundedPoint[]=[];for(let offset=0;offset<current.length;offset+=8){if(this.stopped(id))return [];next.push(...validateSynthesis(await this.ai.documentSynthesis(current.slice(offset,offset+8)),chunks,current.slice(offset,offset+8)))}current=next}if(this.stopped(id))return [];return validateSynthesis(await this.ai.documentSynthesis(current),chunks,current)}
 async ask(input:z.infer<typeof documentAskSchema>){return this.exclusive(input.id,input.consent,async()=>{const chunks=retrieveChunks(this.repository.chunks(input.id),input.question);const result=chunks.length?validateAnswer(await this.ai.documentAnswer(input.question,chunks),chunks):{supported:false,answer:'No relevant source section was found. Try the terminology used in the document or select another chapter.',evidence:[]};if(this.disposed)throw new AppError('CLOSED','The document library closed.');this.repository.answer(input.id,input.question,result);return result})}
 private selection(input:z.infer<typeof documentSelectionSchema>){const chunks=input.chunkIds.map(id=>this.repository.chunk(input.id,id));if(new Set(input.chunkIds).size!==input.chunkIds.length)throw new AppError('INVALID_SELECTION','Select each source section once.');const topics=chunks.flatMap(c=>c.analysis?.concepts.map(p=>p.text)??[]);if(input.topics.some(t=>!topics.includes(t)))throw new AppError('INVALID_SELECTION','A selected topic does not belong to these sections. Refresh its analysis.');return chunks}
 async study(input:z.infer<typeof documentStudySchema>){return this.exclusive(input.id,input.consent,async()=>{const chunks=this.selection(input),doc=this.repository.get(input.id);const generated=documentPlanSchema.parse(await this.ai.documentStudy(input,chunks));const context={goal:input.goal,gapIds:[],minutesPerDay:input.minutesPerDay,deadline:input.deadline,textOnly:true};const plan=validateProposal(generated.plan,context,[]);validateEvidence(evidenceFrom(generated.references),chunks);if(generated.references.length!==plan.tasks.length||new Set(generated.references.map(r=>r.taskKey)).size!==plan.tasks.length||generated.references.some(r=>!plan.tasks.some(t=>t.key===r.taskKey)))throw new AppError('INVALID_EVIDENCE','Every proposed task needs matching source evidence.');if(this.disposed)throw new AppError('CLOSED','The document library closed.');return this.plans.savePlan({id:randomUUID(),goal:input.goal,title:plan.title,rationale:plan.rationale,gapIds:[],gapContext:[],minutesPerDay:input.minutesPerDay,deadline:input.deadline,textOnly:true,state:'proposed',createdAt:new Date().toISOString(),approvedAt:null,tasks:plan.tasks.map(t=>({...t,id:randomUUID(),state:'proposed',completedAt:null,attempts:[]})),documentSources:{documentId:doc.id,title:doc.title,references:generated.references}})})}
 async interview(owner:number,input:z.infer<typeof documentInterviewSchema>){return this.exclusive(input.id,input.consent,async()=>{const chunks=this.selection(input),doc=this.repository.get(input.id);const generated=documentQuestionsSchema.parse(await this.ai.documentQuestions(input.topics,chunks));validateEvidence(evidenceFrom(generated),chunks);if(this.disposed)throw new AppError('CLOSED','The document library closed.');return this.interviews.start(owner,input.config,{documentId:doc.id,title:doc.title,questions:generated.questions})})}
 progress(id:string,chunkId:string,completed:boolean,reviewedCards:number[]){const chunk=this.repository.chunk(id,chunkId);if(reviewedCards.some(index=>!chunk.analysis?.flashcards[index]))throw new AppError('INVALID_SELECTION','This flashcard is unavailable.');this.repository.saveChunk(id,{...chunk,completed,reviewedCards:[...new Set(reviewedCards)]})}
 remove(id:string){if(this.active.has(id))throw new AppError('BUSY','Pause and wait for the current document request before deleting.');if(this.plans.plans().some(p=>p.documentSources?.documentId===id&&p.state!=='rejected')||this.interviews.repository.list().some(s=>s.studyContext?.documentId===id))throw new AppError('DOCUMENT_IN_USE','This document supports a saved plan or interview. Keep its source evidence available.');this.repository.remove(id)}
 close(){this.disposed=true;for(const id of this.active){for(const c of this.repository.chunks(id))if(c.state==='working')this.repository.saveChunk(id,{...c,state:'pending'});const doc=this.repository.get(id);if(doc.state==='analyzing')this.repository.save({...doc,state:'paused',message:'Analysis stopped on application exit; consent and resume to continue.'})}}
}

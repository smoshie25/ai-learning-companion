# Optional model/request overrides, read ONLY by Electron main in --dev mode.
# Enter the API key in Settings, never in this file or VITE_ variables.
OPENAI_RESPONSE_MODEL=gpt-4.1-mini
OPENAI_FOCUSED_MODEL=gpt-4.1
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_TRANSCRIPTION_MODEL=gpt-live-transcribe
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_RETRIES=2

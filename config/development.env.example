# Copy to config/development.env. Read ONLY by Electron main in --dev mode.
# Never prefix credentials with VITE_ or add them to renderer code.
OPENAI_API_KEY=
OPENAI_RESPONSE_MODEL=gpt-4.1-mini
OPENAI_FOCUSED_MODEL=gpt-4.1
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_RETRIES=2
